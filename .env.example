# ============================================
# DJANGO CORE SETTINGS
# ============================================
# Set to True for development, False for production
DEBUG=True

# Generate a new secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-this-in-production

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Set DATABASE_MODE to one of: local, render, aws, custom
# This determines which database configuration is used
DATABASE_MODE=local

# -----------------------------------------------------------------
# LOCAL DATABASE (PostgreSQL - Development)
# -----------------------------------------------------------------
# Local PostgreSQL database configuration
# Database name: HMS_DB, User: postgres, Password: pluralsight, Port: 5432
LOCAL_DATABASE_URL=postgresql://postgres:pluralsight@localhost:5432/HMS_DB
LOCAL_DB_PASSWORD=pluralsight

# -----------------------------------------------------------------
# RENDER PRODUCTION DATABASE
# -----------------------------------------------------------------
# Render.com PostgreSQL database configuration
# Get these values from your Render.com dashboard
RENDER_DATABASE_URL=postgresql://username:password@host:port/database_name
RENDER_DB_PASSWORD=your-render-db-password

# -----------------------------------------------------------------
# AWS RDS DATABASE (Optional)
# -----------------------------------------------------------------
# Amazon RDS PostgreSQL configuration
# Get these values from AWS RDS console
# AWS_DATABASE_URL=postgresql://db_user:password@your-rds-endpoint.rds.amazonaws.com:5432/db_name
# AWS_DB_PASSWORD=your-aws-password

# -----------------------------------------------------------------
# CUSTOM DATABASE (Optional)
# -----------------------------------------------------------------
# Any other PostgreSQL database (DigitalOcean, Linode, etc.)
# CUSTOM_DATABASE_URL=postgresql://user:password@host:port/database
# CUSTOM_DB_PASSWORD=your-password

# ============================================
# ALLOWED HOSTS
# ============================================
# Comma-separated list of domains that can serve your Django app
ALLOWED_HOSTS=localhost,127.0.0.1,admin.smartcarehms.local,lagosgeneral.smartcarehms.local,your-domain.com

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================
# Comma-separated list of frontend origins allowed to access your API
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://another-frontend.com,http://localhost:5173,http://localhost:9090,http://127.0.0.1:5173,http://127.0.0.1:9090

# ============================================
# CSRF TRUSTED ORIGINS
# ============================================
# Comma-separated list of origins trusted for CSRF protection
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:9090,http://127.0.0.1:9090,https://your-frontend-domain.com

# ============================================
# FRONTEND URL
# ============================================
# The URL of your frontend application (for password reset links, etc.)
FRONTEND_URL=https://your-frontend-domain.com/

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Email backend (smtp, console, etc.)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP Server Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Email account credentials
# For Gmail, use an App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD="your-app-password"

# Default sender email addresses
DEFAULT_FROM_EMAIL=your-email@gmail.com
SERVER_EMAIL=your-email@gmail.com

# ============================================
# RATE LIMITING (Disabled by default)
# ============================================
# These are currently disabled in settings.py
# Uncomment DEFAULT_THROTTLE_RATES in settings.py to enable
AUTH_THROTTLE_RATE=1000/min
LOGIN_ATTEMPT_THROTTLE_RATE=5/15min
TWO_FA_THROTTLE_RATE=5/15min
ANON_THROTTLE_RATE=50/hour
PASSWORD_RESET_THROTTLE_RATE=3/hour
PASSWORD_RESET_CONFIRM_THROTTLE_RATE=5/hour
API_THROTTLE_RATE=1000/hour
AUDIT_THROTTLE_RATE=1000/hour

# ============================================
# CELERY (Async Tasks)
# ============================================
# Development: Use memory broker (tasks run synchronously)
CELERY_BROKER_URL=memory://

# Production: Use Redis or RabbitMQ
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# Celery result backend
CELERY_RESULT_BACKEND=django-db

# ============================================
# ENCRYPTION
# ============================================
# 32-character key for AES-256 encryption
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=your-32-char-key-for-encryption-change-this

# ============================================
# PAYMENT GATEWAYS (Optional)
# ============================================
# Paystack Secret Key (get from Paystack dashboard)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Flutterwave Secret Key (get from Flutterwave dashboard)
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# SMS (Optional)
# ============================================
# SMS API Key (for services like Twilio, Africa's Talking, etc.)
SMS_API_KEY=your-sms-api-key

# ============================================
# SECURITY (Production Settings)
# ============================================
# Set to True in production to enforce HTTPS
SECURE_SSL_REDIRECT=False

# ============================================
# APPLICATION-SPECIFIC SETTINGS
# ============================================
# Maximum number of patients per tenant
MAX_PATIENTS_PER_TENANT=10000

# Maximum number of users per tenant
MAX_USERS_PER_TENANT=100

# ============================================
# REDIS CACHE (Optional)
# ============================================
# Uncomment CACHES in settings.py and set this for Redis cache
# REDIS_URL=redis://localhost:6379/0

# ============================================
# STORAGE (Optional - AWS S3, Supabase, etc.)
# ============================================
# AWS S3 Storage (Uncomment in storage.py)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# Supabase Storage
# SUPABASE_URL=your-supabase-url
# SUPABASE_KEY=your-supabase-key
# SUPABASE_BUCKET=your-bucket-name

# ============================================
# LOGGING (Optional)
# ============================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Log file location
# LOG_FILE=logs/smartcare.log

# ============================================
# SENTRY (Error Tracking - Optional)
# ============================================
# SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id

# ============================================
# DJANGO DEBUG TOOLBAR (Optional)
# ============================================
# Enable Django Debug Toolbar for development
# DEBUG_TOOLBAR=True

# ============================================
# EMAIL CONSOLE (For Development - Optional)
# ============================================
# Use console backend for development (prints emails to console)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ============================================
# DATABASE POOLING (Production - Optional)
# ============================================
# Minimum and maximum connection pool size
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=10
# DB_POOL_TIMEOUT=30

# ============================================
# SESSION SETTINGS (Optional)
# ============================================
# Session cookie age in seconds (default: 3600 = 1 hour)
# SESSION_COOKIE_AGE=3600

# Session engine (db, cache, cached_db, etc.)
# SESSION_ENGINE=django.contrib.sessions.backends.db

# ============================================
# API VERSION
# ============================================
# API Version (for versioning)
# API_VERSION=v1

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
# Enable/disable features
# FEATURE_TELEMEDICINE_ENABLED=True
# FEATURE_AI_DIAGNOSTICS_ENABLED=False
# FEATURE_MOBILE_APP_ENABLED=True

# ============================================
# TIMEZONE
# ============================================
# Django timezone (default: Africa/Lagos)
# TIME_ZONE=Africa/Lagos

# ============================================
# LANGUAGE
# ============================================
# Default language (default: en-us)
# LANGUAGE_CODE=en-us

# ============================================
# STATIC & MEDIA FILES (Optional)
# ============================================
# STATIC_URL=/static/
# MEDIA_URL=/media/

# ============================================
# HEALTH CHECKS (Optional)
# ============================================
# Enable health check endpoints
# HEALTH_CHECK_ENABLED=True

# ============================================
# MAINTENANCE MODE (Optional)
# ============================================
# Put the application in maintenance mode
# MAINTENANCE_MODE=False
# MAINTENANCE_MESSAGE=System is undergoing maintenance. Please try again later.